+#ifndef TOOLS_ENABLED
+void FileAccess::wr_confine_begin() {
+	const String resources = ProjectSettings::get_singleton()->get_resource_path();
+	wr_roots[0] = OS::get_singleton()->get_user_data_dir().replace_char('\\', '/').trim_suffix("/");
+	wr_roots[1] = ProjectSettings::get_singleton()->is_using_datapack() ? String() : resources.replace_char('\\', '/').trim_suffix("/");
+	// Android and the web serve res:// with no project directory: a relative path there is in the APK or the page.
+	// Anywhere else an empty resource path (--main-pack) resolves a relative res:// against the working directory,
+	// where a host keeps its slot: the pack's stored copy, override.cfg, user.pack. So res:// is the pack alone there.
+#if defined(ANDROID_ENABLED) || defined(WEB_ENABLED)
+	wr_relative_resources = resources.is_empty();
+#else
+	wr_relative_resources = false;
+#endif
+	wr_confined = true;
+}
+
+String FileAccess::wr_confine(const String &p_os_path, bool p_resources) {
+	const String path = p_os_path.replace_char('\\', '/');
+	if (!path.split("/").has("..")) {
+		for (const String &root : wr_roots) {
+			if (!root.is_empty() && (path == root || path.begins_with(root + "/"))) {
+				return p_os_path;
+			}
+		}
+		if (p_resources && wr_relative_resources && path.is_relative_path() && !path.contains("://")) {
+			return p_os_path;
+		}
+	}
+	print_verbose(vformat("Wallpaper Reactor: '%s' is outside res:// and user://.", p_os_path));
+	return "/" + String("wr-confined-").repeat(24); // One 288-character name: no filesystem opens or creates it.
+}
+#endif // TOOLS_ENABLED
+
 String FileAccess::fix_path(const String &p_path) const {
 	// Helper used by file accesses that use a single filesystem.
+#ifndef TOOLS_ENABLED
+	if (wr_confined && wr_trusted == 0) {
+		WrTrusted resolving; // Resolve as stock Godot does, then confine what that resolved to.
+		return wr_confine(FileAccess::fix_path(p_path), _access_type == ACCESS_RESOURCES);
+	}
+#endif // TOOLS_ENABLED
 
 	String r_path = p_path.replace_char('\\', '/');
 
