+#ifndef TOOLS_ENABLED
+// Wallpaper Reactor (patches/harden.patch): a method named in native-deny-list.json is never
+// registered, so no script, Callable, Object.call or ClassDB lookup can reach it. The list is data, generated into
+// this header at build time; every bind path below (instance, static, vararg, custom) asks here first.
+#include "core/object/wr_native_deny_list.gen.h"
+
+static bool _wr_denied(const StringName &p_class, const StringName &p_method) {
+	for (const char *const *entry : WR_NATIVE_DENY_LIST) {
+		if (p_class == entry[0] && p_method == entry[1]) {
+			print_verbose(vformat("%s: %s::%s not bound", WR_NATIVE_DENY_LIST_ID, p_class, p_method));
+			return true;
+		}
+	}
+	return false;
+}
+#endif // TOOLS_ENABLED
