@@ -204,4 +204,52 @@ Error image_to_png(const Ref<Image> &p_image, Vector<uint8_t> &p_buffer) {
 
 	return OK;
 }
+
+#ifndef TOOLS_ENABLED
+static void wr_png_write(png_structp p_png, png_bytep p_data, png_size_t p_length) {
+	Vector<uint8_t> *buffer = static_cast<Vector<uint8_t> *>(png_get_io_ptr(p_png));
+	const int offset = buffer->size();
+	buffer->resize(offset + p_length);
+	memcpy(buffer->ptrw() + offset, p_data, p_length);
+}
+
+static void wr_png_flush(png_structp) {}
+
+// Apart from image_to_png_fast: a libpng error longjmps out of here, so nothing in this function owns memory.
+static bool wr_png_encode(const uint8_t *p_pixels, int p_width, int p_height, int p_channels, Vector<uint8_t> *p_buffer) {
+	png_structp png = png_create_write_struct(PNG_LIBPNG_VER_STRING, nullptr, nullptr, nullptr);
+	if (!png) {
+		return false;
+	}
+	png_infop info = png_create_info_struct(png);
+	if (!info || setjmp(png_jmpbuf(png))) {
+		png_destroy_write_struct(&png, &info);
+		return false;
+	}
+	png_set_write_fn(png, p_buffer, wr_png_write, wr_png_flush);
+	png_set_IHDR(png, info, p_width, p_height, 8, p_channels == 4 ? PNG_COLOR_TYPE_RGBA : PNG_COLOR_TYPE_RGB,
+			PNG_INTERLACE_NONE, PNG_COMPRESSION_TYPE_DEFAULT, PNG_FILTER_TYPE_DEFAULT);
+	png_set_compression_level(png, 1);
+	png_set_filter(png, PNG_FILTER_TYPE_BASE, PNG_FILTER_SUB);
+	png_write_info(png, info);
+	for (int y = 0; y < p_height; y++) {
+		png_write_row(png, p_pixels + (size_t)y * p_width * p_channels);
+	}
+	png_write_end(png, info);
+	png_destroy_write_struct(&png, &info);
+	return true;
+}
+
+Error image_to_png_fast(const Ref<Image> &p_image, Vector<uint8_t> &p_buffer) {
+	const Image::Format format = p_image->get_format();
+	if (format != Image::FORMAT_RGB8 && format != Image::FORMAT_RGBA8) {
+		return image_to_png(p_image, p_buffer);
+	}
+	const int channels = format == Image::FORMAT_RGBA8 ? 4 : 3;
+	const Vector<uint8_t> data = p_image->get_data();
+	ERR_FAIL_COND_V(data.size() != p_image->get_width() * p_image->get_height() * channels, FAILED);
+	ERR_FAIL_COND_V(!wr_png_encode(data.ptr(), p_image->get_width(), p_image->get_height(), channels, &p_buffer), FAILED);
+	return OK;
+}
+#endif
 } // namespace PNGDriverCommon
